# Server Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database Configuration (Local Postgres)
# DATABASE_URL is the sole source of truth for the app's connection — the
# consolidated backend/db.js pool reads it directly. To fail over (e.g. to
# the Pi standby), change this one value and restart.
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/imms_inventory
DB_SSL=false

# Discrete DB_* vars below are NOT read by the running app. They exist
# only for tooling that needs separate fields (e.g. PowerShell backup
# scripts that pass --host/--username to pg_dump). Keep in sync with
# DATABASE_URL above.
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imms_inventory

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
SESSION_SECRET=your_session_secret
COOKIE_SECRET=your_cookie_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=3000

# Session Configuration
SESSION_SECURE=false
SESSION_MAX_AGE=86400000

# Maximum concurrent users per device
MAX_USERS_PER_DEVICE=10

# Email Configuration (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=IMMS Inventory <your_email@gmail.com>
REROUTE_EMAIL=approver@yourcompany.com
PO_APPROVAL_REROUTE_EMAIL=approver@yourcompany.com

# Fallback Email (optional)
FALLBACK_SMTP_HOST=smtp.sendgrid.net
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_SECURE=false
FALLBACK_SMTP_USER=apikey
FALLBACK_SMTP_PASSWORD=YOUR_SENDGRID_API_KEY

# IMAP Configuration (for email monitoring)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
PROCESS_ALL_EMAILS=true

# Notification Recipients
NOTIFICATION_RECIPIENTS=admin@yourcompany.com

# Socket.IO
SOCKET_URL=http://localhost:4000

# PO Approval Re-routing
PO_APPROVAL_REROUTE_ENABLED=true
PO_APPROVAL_REROUTE_SUBJECT_PREFIX=[APPROVED PO]
DEFAULT_REROUTE_EMAIL=approver@yourcompany.com

# Notifications (Email reuses SMTP_* above; SMS uses Twilio)
NOTIFICATIONS_ENABLED=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sender: set ONE. Messaging Service SID is preferred (required path for toll-free numbers)
# and takes precedence over TWILIO_FROM when both are present.
TWILIO_MESSAGING_SERVICE_SID=MGd79e2e54e5b3cb6f15edec8615ad420b
TWILIO_FROM=+15555550123
DIGEST_CRON=0 7 * * *
RECONCILER_INTERVAL_MS=60000

# ─── Monthly analytics email ────────────────────────────────────────────────
# Recipients of the monthly maintenance-analytics report (comma-separated).
# Empty = feature off.
ANALYTICS_RECIPIENTS=
# Base URL IMMS uses to reach the MCS API (must include /api/v1).
MCS_BASE_URL=http://localhost:4001/api/v1
# Cron window for the monthly send. The handler still only sends on the first
# business day of the month. Default: 7am on the first five days.
MONTHLY_ANALYTICS_CRON=0 7 1-5 * *

# ─── Observability ──────────────────────────────────────────────────────────
# Error tracking DSN (Sentry.io or a self-hosted GlitchTip project). Empty = off.
SENTRY_DSN=
# Optional release tag reported with errors.
SENTRY_RELEASE=
# Uptime alerts: comma-separated recipients. Empty = uptime alerts off.
OPS_ALERT_RECIPIENTS=
# Uptime poll interval (ms) and the URLs to check (comma-separated; defaults to
# the five prod URLs).
UPTIME_INTERVAL_MS=120000
UPTIME_URLS=
