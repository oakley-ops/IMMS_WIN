# ─── Server ─────────────────────────────────────────────────────────────────
# Port the Express server binds to. Defaults to 4001.
PORT=4001

# Node environment: development | production | test
# Drives logger formatting and DB SSL strictness.
NODE_ENV=development

# Allowed CORS origins (comma-separated). Required for the frontend to
# reach the API from a browser.
CORS_ORIGIN=http://localhost:3003

# ─── Security ───────────────────────────────────────────────────────────────
# JWT signing secret. REQUIRED. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value to git.
JWT_SECRET=change-me

# ─── Database ───────────────────────────────────────────────────────────────
# Either set DATABASE_URL (preferred, used in production) ...
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ... or set the individual connection fields (used in development).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiservinventory
DB_USER=postgres
DB_PASSWORD=postgres

# Set to "true" to enable SSL with rejectUnauthorized:false in dev.
# Almost always leave this unset locally.
DB_SSL=false

# Set to "true" ONLY when your managed Postgres provider requires accepting
# self-signed certs in production. Defaults to strict verification.
DB_SSL_INSECURE=false

# ─── Logging ────────────────────────────────────────────────────────────────
# Override the default log level (silent | error | warn | info | debug | trace).
# Defaults: production=info, test=silent, development=debug.
# LOG_LEVEL=info

# ─── IMMS integration ───────────────────────────────────────────────────────
# Base URL of the IMMS API (must include /api/v1). Used to decrement
# parts.quantity in IMMS when a technician logs parts used on a call.
IMMS_API_URL=http://localhost:4000/api/v1

# ─── Observability ──────────────────────────────────────────────────────────
# Error tracking DSN (Sentry.io or a self-hosted GlitchTip project). Empty = off.
SENTRY_DSN=
SENTRY_RELEASE=
