# Copy to .env.local and fill in values for each site deployment.
# All Next.js env vars exposed to the browser must be prefixed NEXT_PUBLIC_.

# Backend REST API base URL. Must include the /api/v1 path.
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Socket.io server URL (no /api path). Used by CallBoard and CallStation
# for real-time call updates.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# Optional site label shown in the login screen and nav. Leave blank to
# fall back to "Maintenance Call System".
NEXT_PUBLIC_SITE_NAME=Plant 1

# Server-side only (used by Next.js server components / API routes if any).
BACKEND_URL=http://localhost:4001
