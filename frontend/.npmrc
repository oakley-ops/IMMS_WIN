# The frontend intentionally pins @mui/lab@7 (beta) alongside @mui/material@5,
# which npm's strict peer-dependency resolver rejects. This is the installed,
# running combination; legacy-peer-deps lets `npm ci` (cutover + deploy.ps1)
# reproduce it without --legacy-peer-deps on the command line. Resolve the MUI
# version split (lab->v5 or material->v7) to remove this.
legacy-peer-deps=true
